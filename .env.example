# PostgreSQL Database Connection String (Prisma)
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="postgresql://attendance_user:your_secure_password@localhost:5432/attendance_db?schema=public"

# Terminal on the office LAN (see net_if2.xml — Wi-Fi address 192.168.10.16).
# These values are used only until you save Settings in the app.
HIK_HOST=192.168.10.16
HIK_PORT=80
HIK_HTTPS=false
HIK_USER=admin
HIK_PASSWORD=

# This PC or Cloud domain which the terminal pushes events to.
LISTENER_HOST=attendance.sfkworks.online
LISTENER_PORT=443
LISTENER_HTTPS=true
